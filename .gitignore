*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
*.egg-info/
*.egg

# Persistencia Local SQLite
*.db
*.sqlite
*.sqlite3

# Entornos IDE & Sistema Operativo
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ==========================================
# Exclusión Estricta de Proyectos Frontend
